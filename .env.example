# Onihayo environment template.
#
# Copy to `.env` for local overrides. Never commit a real `.env` file; it is gitignored.
# Production values are set as secrets/variables in the hosting platform, never in the repo.
# Local PostgreSQL credentials are for development only. Use separate values in
# each local environment. Production credentials belong in the hosting secret store.

# --- Node adapter (production server: `pnpm build && pnpm start`) -------------

# Public origin of the site. Required in production so SvelteKit's CSRF origin
# check and absolute URLs are correct behind a reverse proxy. Must be https:// in production.
ORIGIN=http://localhost:3000

# Interface and port the Node server binds to.
HOST=127.0.0.1
PORT=3000

# Maximum request body size. Onihayo accepts no uploads; keep this small.
BODY_SIZE_LIMIT=64K

# Only set these when a trusted reverse proxy overwrites the headers. Trusting
# client-supplied headers lets anyone spoof their IP address or origin.
# ADDRESS_HEADER=X-Forwarded-For
# XFF_DEPTH=1

# --- Local PostgreSQL (milestone 0.9 foundation) ----------------------------
# `docker compose up -d db` creates separate app and migration roles on first start.
# Set distinct, strong local values before starting the database.
POSTGRES_BOOTSTRAP_PASSWORD=replace-me-local-bootstrap-password
MIGRATION_DATABASE_PASSWORD=replace-me-local-migration-password
APP_DATABASE_PASSWORD=replace-me-local-app-password
DATABASE_URL=postgres://onihayo_app:replace-me-local-app-password@localhost:5432/onihayo
MIGRATION_DATABASE_URL=postgres://onihayo_migration:replace-me-local-migration-password@localhost:5432/onihayo

# --- Optional account authentication (disabled until SES/privacy review) ----
# Enable only after migrations, HTTPS/proxy configuration, SES sender and
# credentials, and the provider privacy review are complete.
AUTH_ENABLED=false
# Verified SES sender address. Required when AUTH_ENABLED=true.
# AUTH_EMAIL_FROM=accounts@example.invalid
# Generate a fresh 32-byte base64url key per environment; store it as a secret.
# AUTH_RATE_LIMIT_KEY=replace-with-32-byte-base64url-secret
# AWS credentials are supplied by the platform role or AWS credential chain;
# never place them in this file or the repository.
